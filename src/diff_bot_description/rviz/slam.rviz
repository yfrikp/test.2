# =============================================================================
#  slam.rviz —— 题目(3) SLAM 建图专用 RViz 配置
#
#  和 diff_bot.rviz 的唯一关键差别：
#      Fixed Frame 从 odom 改成了 **map**
#
#  为什么必须改：
#      SLAM 的工作就是"发布 map → odom 的变换"（把里程计的漂移修正掉）。
#      如果固定坐标系用 odom，你看到的是**未修正**的里程计视角，
#      地图会跟着车一起漂 —— 看起来就像"地图在动、车不动"。
#      换成 map 之后，是"车在一个固定的世界里动"，这才是建图应有的视角。
#
#  显示项：
#      Map          /map           ← SLAM 建出来的栅格地图（主角）
#      LaserScan    /scan          ← 实时雷达点
#      PatrolRoute  /patrol_route  ← 自动巡逻路线（蓝）
#      PlannedPath  /planned_path  ← 题目2 规划出的 A→B 曲线（绿）
#      TF / RobotModel / Grid
# =============================================================================
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4
      Frame Timeout: 15

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false

    # ---- 实时雷达点：建图时能直接看出"雷达看到了什么" ----
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0

    # ---- ★ 主角：SLAM 建出来的地图 ----
    #  Durability Policy 必须是 Transient Local：
    #  slam_toolbox 只在**地图更新时**才发一次 /map（不是每帧都发），
    #  用默认的 Volatile 的话，RViz 启动晚一点就永远收不到第一份地图，
    #  表现为"RViz 里地图一直空白"。这是新手最常踩的建图坑。
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 1
      Update Topic:
        Value: /map_updates

    - Class: rviz_default_plugins/Path
      Name: PatrolRoute
      Enabled: true
      Topic:
        Value: /patrol_route
      Color: 0; 170; 255
      Line Style: Lines
      Line Width: 0.03

    - Class: rviz_default_plugins/Path
      Name: PlannedPath
      Enabled: true
      Topic:
        Value: /planned_path
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03

  Global Options:
    # ★★ 关键：建图必须用 map，不能用 odom（原因见文件头）
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # 俯视角看地图（Pitch 接近 90° = 正俯视）
      Distance: 7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.35
      Yaw: 0.0
      Target Frame: <Fixed Frame>

Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
  Views:
    collapsed: false
