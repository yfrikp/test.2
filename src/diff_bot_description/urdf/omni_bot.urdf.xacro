<?xml version="1.0"?>
<!--
  题目2（1）：四轮麦轮全向底盘 omni_bot
  - 4 个麦轮：前后 ±0.10 m、左右 ±0.13 m，半径 0.05 m
  - MecanumDrive 按 vx/vy/wz 计算四个轮的转速，并发布 /odom 与 TF
  - 圆柱轮在接触模型里产生不了侧向力（实测横移位移为 0），所以另加 VelocityControl
    把 base_link 的平面速度直接置为指令值，实现运动学全向；两套系统共用同一份 cmd_vel
-->
<robot name="omni_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sim" default="gz"/>
  <xacro:property name="sim" value="$(arg sim)"/>

  <xacro:property name="chassis_len"  value="0.30"/>
  <xacro:property name="chassis_wid"  value="0.24"/>
  <xacro:property name="chassis_hgt"  value="0.10"/>
  <xacro:property name="chassis_mass" value="3.0"/>
  <xacro:property name="wheel_rad"    value="0.05"/>
  <xacro:property name="wheel_wid"    value="0.03"/>
  <xacro:property name="wheel_mass"   value="0.2"/>
  <xacro:property name="wheel_sep"    value="0.26"/>
  <xacro:property name="wheelbase"    value="0.20"/>

  <material name="grey">  <color rgba="0.55 0.55 0.58 1.0"/></material>
  <material name="black"> <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="red">   <color rgba="0.85 0.15 0.15 1.0"/></material>
  <material name="yellow"><color rgba="0.95 0.80 0.10 1.0"/></material>

  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(h*h+w*w)/12.0}" ixy="0" ixz="0"
               iyy="${m*(l*l+h*h)/12.0}" iyz="0"
               izz="${m*(l*l+w*w)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*r*r/2.0}"          iyz="0"
               izz="${m*(3*r*r+h*h)/12.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_rad + chassis_hgt/2}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_len} ${chassis_wid} ${chassis_hgt}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_len} ${chassis_wid} ${chassis_hgt}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" l="${chassis_len}" w="${chassis_wid}" h="${chassis_hgt}"/>
  </link>

  <!-- 车头指示块：便于在仿真里看清朝向 -->
  <joint name="nose_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="nose_link"/>
    <origin xyz="${chassis_len/2} 0 0" rpy="0 0 0"/>
  </joint>
  <link name="nose_link">
    <visual>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.06 0.03"/></geometry>
    </collision>
    <xacro:box_inertia m="0.02" l="0.03" w="0.06" h="0.03"/>
  </link>

  <!-- 四个麦轮（圆柱轮 + 正常摩擦）：转速由 MecanumDrive 按 vx/vy/wz 计算 -->
  <xacro:macro name="mecanum_wheel" params="prefix joint_name x_sign y_sign fx fy">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_rad}" length="${wheel_wid}"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_rad*1.01}" length="${wheel_wid*0.35}"/></geometry>
        <material name="yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_rad}" length="${wheel_wid}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_rad}" h="${wheel_wid}"/>
    </link>
    <joint name="${joint_name}" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="${x_sign*wheelbase/2} ${y_sign*wheel_sep/2} ${-chassis_hgt/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="20" velocity="20"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <fdir1>${fx} ${fy} 0</fdir1>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left"  joint_name="front_left_joint"  x_sign="1"  y_sign="1"  fx="0.7071"  fy="0.7071"/>
  <xacro:mecanum_wheel prefix="front_right" joint_name="front_right_joint" x_sign="1"  y_sign="-1" fx="-0.7071" fy="0.7071"/>
  <xacro:mecanum_wheel prefix="back_left"   joint_name="back_left_joint"   x_sign="-1" y_sign="1"  fx="0.7071"  fy="-0.7071"/>
  <xacro:mecanum_wheel prefix="back_right"  joint_name="back_right_joint"  x_sign="-1" y_sign="-1" fx="-0.7071" fy="-0.7071"/>

  <gazebo>
    <plugin filename="ignition-gazebo-mecanum-drive-system"
            name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>front_left_joint</front_left_joint>
      <front_right_joint>front_right_joint</front_right_joint>
      <back_left_joint>back_left_joint</back_left_joint>
      <back_right_joint>back_right_joint</back_right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheelbase>${wheelbase}</wheelbase>
      <wheel_radius>${wheel_rad}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>
  </gazebo>
  <!-- 运动学全向：把 base_link 的平面速度直接置为指令值（车体系已由 omni_bridge 转成世界系）。
       圆柱轮在接触模型上无法产生侧向力，因此横移用这套系统实现；轮子仍由上面的
       MecanumDrive 按同一份 cmd_vel 转动，/odom 与 TF 也由它发布。 -->
  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <topic>/omni_cmd_vel_world</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
  </gazebo>
</robot>
