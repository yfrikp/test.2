<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="my_own_map">


    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>


    <include><uri>model://sun</uri></include>


    <include><uri>model://ground_plane</uri></include>


    <model name="point_A">
      <static>true</static>
      <pose>-2.0 -2.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.06</radius><length>1.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="point_B">
      <static>true</static>
      <pose>2.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.06</radius><length>1.0</length></cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <model name="center_block">
      <static>true</static>
      <pose>0.0 0.0 0.3 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.3 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.3 0.6</size></box></geometry>
        </visual>
      </link>
    </model>


    <model name="corner_c1">
      <static>true</static>
      <pose>-1.2 1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="corner_c2">
      <static>true</static>
      <pose>1.2 1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="corner_c3">
      <static>true</static>
      <pose>-1.2 -1.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
        </visual>
      </link>
